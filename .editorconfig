# EditorConfig is awesome: https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown
[*.md]
trim_trailing_whitespace = false

# Python
[*.py]
indent_size = 4

# TOML (pyproject.toml 등)
[*.toml]
indent_size = 4

# YAML
[*.{yml,yaml}]
indent_size = 2

# JSON
[*.json]
indent_size = 2

# Shell
[*.sh]
indent_size = 2

# Docker
[Dockerfile]
indent_size = 4

[*.dockerfile]
indent_size = 4